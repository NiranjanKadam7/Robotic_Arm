<?xml version="1.0"?>
<robot  xmlns:xacro="http://www.ros.org/wiki/xacro">


    <link name="world"/>

    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/Base.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="blue"/>
            <origin xyz="0 0 0.17" rpy="${pi / 2.0} 0 0"/>
        </visual>

       <collision>
           <geometry>
             <sphere  radius ="0.35" />
           </geometry>
           
           <origin xyz="0 0 0.17" rpy ="${pi / 2.0} 0 0"/> 
        </collision>

        <xacro:cylinder_inertia m="15" r="0.35" l="0.60"
                               o_xyz="0 0 0.17" o_rpy="${pi / 2.0} 0 0"/>
    </link>


     <link name="Waist">
        <visual>
            <origin xyz="0 0 0"  rpy="${pi / 2.0} 0 0"/>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/Waist.stl" scale="0.01 0.01 0.01"/>
            </geometry>
            <material name="blue"/>
        </visual>

        <collision>
           <geometry>
             <sphere  radius ="0.35" />
           </geometry>
           <origin xyz="0 0 0"  rpy="${pi / 2.0} 0 0"/>
        </collision>

        <xacro:cylinder_inertia m="8" r="0.35" l="0.30"
                                o_xyz="0 0 0" o_rpy="${pi / 2.0} 0 0"/>
    </link> 



    <link name="arm_1">

        <visual>
            <origin xyz ="0.06 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}"/>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/Arm_01.stl" scale ="0.01 0.01 0.01"/>
            </geometry>
            <material name="grey">
            </material>
        </visual>

        <collision>
            <geometry>
                <box size="0.40 1.40 0.20"/>
            </geometry>
            <origin xyz ="0.06 0 0" rpy="${pi / 2.0} 0 ${pi / 2.0}"/>
        </collision>

        <xacro:box_inertia m="5" x="0.40" y="1.40" z="0.20"
                       o_xyz="0.06 0 0" o_rpy="${pi / 2.0} 0 ${pi / 2.0}"/>
    </link>


    <link name="arm_2">

        <visual>
            <origin xyz ="-0.005 1.3 0" rpy="0 0 ${pi}"/>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/Arm_02.stl" scale ="0.01 0.01 0.01"/>
            </geometry>
            <material name="grey"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.40 1.40 0.20"/>
            </geometry>
            <origin xyz ="-0.005 1.3 0" rpy="0 0 ${pi}"/>
        </collision>

        <xacro:box_inertia m="5" x="0.40" y="1.40" z="0.20"
                       o_xyz="-0.005 1.3 0" o_rpy="0 0 ${pi}"/> 

    </link>


    <link name="gripper">

        <visual>
            <origin xyz ="0.05 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://my_robot_description/meshes/Gripper.stl" scale ="0.03 0.03 0.03"/>
            </geometry>
            <material name="green"/>
        </visual>

        <collision>
             <geometry>
                 <box size="0.35 0.20 0.30"/>
             </geometry>
             <origin xyz ="0.05 0 0" rpy="0 0 0"/>
        </collision>
        
        <xacro:box_inertia m="2" x="0.35" y="0.20" z="0.30"
                       o_xyz="0.05 0 0" o_rpy="0 0 0"/>

    </link>

    <joint name="virtual_joint" type="fixed">
        <parent link="world"/>
        <child link ="base_link"/>
        <origin xyz ="0 0 0" rpy ="0 0 0"/>
    </joint>

    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="Waist"/>
        <origin xyz="-0.0285 0 0.6" rpy="0 0 0" />
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="200" velocity="1.0"/>
    </joint> 
    <joint name="joint_2" type="revolute">
        <parent link="Waist"/>
        <child link="arm_1"/>
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz ="-0.035 0.14 0.37"/>
        <limit lower="${-pi / 2.0}" upper="${pi / 2.0}" effort="200" velocity="1.0"/>

    </joint>
    <joint name="joint_3" type="revolute">
        <parent link="arm_1"/>
        <child link="arm_2"/>
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz ="0 0 1.20"/>
        <limit lower="0" upper="${pi}" effort="200" velocity="1.0"/>

    </joint> 

    <joint name="joint_4" type="revolute">
        <parent link="arm_2"/>
        <child link="gripper"/>
        <axis xyz="1 0 0"/>
        <origin rpy="0 0 0" xyz ="0 1.3 0"/>
        <limit lower="0" upper="${pi}" effort="200" velocity="1.0"/>

    </joint>  

</robot>
